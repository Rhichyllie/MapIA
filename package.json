{
  "name": "mapia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "dev:with-db": "pnpm db:check:wait && next dev",
    "dev:e2e": "pnpm db:check:wait && pnpm prisma generate && next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm db:check:wait && playwright test",
    "test:e2e:editor": "pnpm db:check:wait && playwright test tests/e2e/editor-flow.spec.ts --project=chromium",
    "test:e2e:editor:headed": "pnpm db:check:wait && playwright test tests/e2e/editor-flow.spec.ts --project=chromium --headed",
    "test:e2e:headed": "pnpm db:check:wait && playwright test --headed",
    "test:e2e:ui": "pnpm db:check:wait && playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:check": "tsx scripts/db-check.ts",
    "db:check:wait": "tsx scripts/db-check.ts --wait=30000",
    "db:seed": "prisma db seed",
    "db:reset-local": "docker compose down -v && docker compose up -d postgres && pnpm prisma migrate deploy && pnpm db:seed",
    "telemetry:retention:cleanup": "tsx scripts/creation-telemetry-retention-cleanup.ts --dry-run=true",
    "telemetry:retention:cleanup:execute": "tsx scripts/creation-telemetry-retention-cleanup.ts --dry-run=false --confirm=execute",
    "observability:validate": "python infra/observability/scripts/validate-observability.py --smoke-render --smoke-apply-script --smoke-evidence-scripts",
    "observability:4e9r:preconditions": "python infra/observability/scripts/check-4e9r-preconditions.py --require-ready-env",
    "observability:4e9r:run": "python infra/observability/scripts/run-4e9r-real.py --require-ready-env --strict-ready-mode always",
    "observability:4e9r:run:dev-local": "python infra/observability/scripts/run-4e9r-real.py --require-ready-env --environment-scope dev_local --strict-ready-mode skip_in_dev_local",
    "observability:4e9r:run:dev-local:win": "python infra/observability/scripts/run-4e9r-real-dev-local-win.py",
    "observability:datasources:discover": "python infra/observability/scripts/discover-grafana-datasource-uids.py",
    "observability:apply:dry-run": "python infra/observability/scripts/apply-observability.py --dry-run",
    "observability:post-apply:smoke": "python infra/observability/scripts/post-apply-smoke.py --dry-run",
    "observability:evidence:collect:template": "python infra/observability/scripts/collect-observability-evidence.py --template-only --output infra/observability/evidence/observability-evidence.4e9.template.json",
    "observability:baseline:promote": "python infra/observability/scripts/promote-baseline-4e9.py"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.5.1",
    "@opentelemetry/core": "^2.5.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/instrumentation-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/client": "^6.19.2",
    "@xyflow/react": "^12.10.1",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "1.58.2",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
